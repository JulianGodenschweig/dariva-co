# Formspree (existing marketing-site contact / waitlist forms)
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# ─────────────────────────────────────────────────────────────────────────────
# Supabase (LMS) — copy these into .env.local (gitignored) with real values.
# Find them in your Supabase project: Settings → API.
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIC values — safe to send to the browser (that's what NEXT_PUBLIC_ means):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-ONLY secret. DO NOT add the NEXT_PUBLIC_ prefix, never commit it,
# never import it into client code. Not needed for Phase 1 (lecturer approvals
# run through RLS with the lecturer's own session) — reserved for later.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
